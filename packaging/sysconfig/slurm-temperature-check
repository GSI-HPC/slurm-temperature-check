# Flags for slurm-temperature-check, passed as $OPTIONS by the systemd unit.
# Run `slurm-temperature-check --help` for the full list.
#
# Examples:
#   OPTIONS="--interval=5s --read-retries=0"
#   OPTIONS="--log.level=debug --log.format=json"
#
# --interval needs no matching change to WatchdogSec= in the unit: the
# staleness window the guard applies already follows the interval. Raising
# WatchdogSec= only makes a wedged loop take longer to notice.
OPTIONS=""
